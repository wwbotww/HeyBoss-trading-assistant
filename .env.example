# =============================================================================
# IB Gateway（仅使用 paper 账户）
# =============================================================================
# IBKR paper 用户名和密码。不要在此模板中填写真实值，也不要提交 .env。
TWS_USERID=
TWS_PASSWORD=
# paper 账户编号，通常以 DU 开头。
TWS_ACCOUNT=
TRADING_MODE=paper
# paper 交易需要允许下单；切勿改为 live。
READ_ONLY_API=no
# 由 IBC 自动接受来自受控 Compose 网络的 API 连接提示。
TWS_ACCEPT_INCOMING=accept
# 宿主机访问 IB Gateway paper API 的标准端口。
IB_HOST=127.0.0.1
IB_PORT=4002
# Compose 网络内通过 socat 暴露的 paper API 端口。
IB_DOCKER_HOST=ib-gateway
IB_DOCKER_PORT=4004
IB_DATA_CLIENT_ID=1201
IB_EXEC_CLIENT_ID=1202
IB_CHECK_CLIENT_ID=1299
IB_MAX_CONNECTION_ATTEMPTS=10

# EODHD 历史日线 API token。仅从环境变量读取，禁止提交真实值。
EODHD_API_TOKEN=

# IBC / Gateway 生命周期。默认 UTC，便于统一事件时间。
TIME_ZONE=Etc/UTC
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
AUTO_RESTART_TIME="11:59 PM"
# 可选：设置后可通过 127.0.0.1:5900 检查 Gateway GUI。
VNC_SERVER_PASSWORD=

# =============================================================================
# Telegram 审批与通知
# =============================================================================
TELEGRAM_BOT_TOKEN=
# 首次可留空并向 Bot 发送 /start，Bot 会返回当前 chat ID；填入后重启服务。
TELEGRAM_CHAT_ID=

# =============================================================================
# 本地存储与应用
# =============================================================================
# live/paper 审批与回测审计必须物理隔离，禁止指向同一个数据库文件。
LIVE_DATABASE_URL=sqlite:///./data/live.db
BACKTEST_DATABASE_URL=sqlite:///./data/backtest.db
# 市场雷达只保存同步运行和已发布派生快照；不得与交易审计库混用。
MARKET_RADAR_DATABASE_URL=sqlite:///./data/market-radar.db
CATALOG_PATH=./catalog/eodhd
REPORT_ROOT=./reports/backtests
DATA_QUALITY_REPORT_ROOT=./reports/data-quality
MARKET_RADAR_REPORT_ROOT=./reports/market-radar
LOG_LEVEL=INFO
PORTFOLIO_SNAPSHOT_STALE_SECONDS=90
# 只读 Web 操作台仅绑定本机回环地址。
WEB_PORT=8080
